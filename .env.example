# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/mealbot

# Server Configuration
PORT=8080

# Auth0 Configuration
AUTH0_ISSUER=https://mealbot.auth0.com/
AUTH0_AUDIENCE=https://mealbot-2.herokuapp.com/
AUTH0_JWKS_URL=https://mealbot.auth0.com/.well-known/jwks.json

# Mailgun Configuration
MAILGUN_DOMAIN=your-mailgun-domain.mailgun.org
MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_SMTP_LOGIN=postmaster@your-mailgun-domain.mailgun.org

# Application Configuration
DEBUG=False
LOG_LEVEL=INFO

# CORS Configuration (comma-separated list of origins, or "*" for all)
CORS_ORIGINS=*
