# Server configuration
PORT=5000

# PostgreSQL database connection string
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://localhost/mealbot

# Mailgun configuration (for email sending)
MAILGUN_SMTP_LOGIN=
MAILGUN_DOMAIN=
MAILGUN_API_KEY=

# Auth0 configuration
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
AUTH0_ISSUER=
AUTH0_JWKS_URL=
